#!/bin/bash
#PBS -N Lab6_MPI_pthreads
#PBS -l nodes=2:ppn=12
#PBS -l walltime=01:30:00
#PBS -j oe

cd $PBS_O_WORKDIR

SRC="../src/lb.cpp"
BIN="./lb"
BIN_MPE="./lb_mpe"

echo "============================================================"
echo "  Сборка"
echo "============================================================"

mpiicpc -mt_mpi -O2 -std=c++11 -o $BIN $SRC -lm -lpthread

# MPE: пробуем разные варианты линковки
MPE_OK=0
if command -v mpecxx >/dev/null 2>&1; then
    mpecxx -mpilog -mt_mpi -O2 -std=c++11 -o $BIN_MPE $SRC -lm -lpthread && MPE_OK=1
fi
if [ $MPE_OK -eq 0 ]; then
    # ищем libmpe вручную
    MPE_LIB=$(find /usr /opt 2>/dev/null -name "libmpe.so" -o -name "libmpe.a" 2>/dev/null | head -1)
    MPE_DIR=$(dirname "$MPE_LIB" 2>/dev/null)
    if [ -n "$MPE_DIR" ]; then
        mpiicpc -mt_mpi -O2 -std=c++11 -o $BIN_MPE $SRC -lm -lpthread \
            -L"$MPE_DIR" -lmpe -llmpe && MPE_OK=1
    fi
fi
if [ $MPE_OK -eq 0 ]; then
    echo "ВНИМАНИЕ: MPE недоступен, lb_mpe не собран"
    BIN_MPE=""
fi

echo "Сборка завершена."
echo ""

echo "============================================================"
echo "  Замеры производительности"
echo "============================================================"

NP_LIST="1 2 4 8 12 16 24"

for NP in $NP_LIST; do
    echo ""
    echo "--- NP = ${NP} ---"
    if [ "$NP" -le 12 ]; then
        mpirun -machinefile $PBS_NODEFILE -np $NP \
            $BIN > result_np${NP}.txt 2>&1
    else
        mpirun -machinefile $PBS_NODEFILE -np $NP -perhost 12 \
            $BIN > result_np${NP}.txt 2>&1
    fi
    grep "Tmax\|imbalance" result_np${NP}.txt | head -10
done

echo ""
echo "============================================================"
echo "  Сводная таблица"
echo "============================================================"

T_BASE=$(grep "Tmax" result_np1.txt | awk '{sum += $3} END {printf "%.4f", sum}')

printf "%-5s | %-14s | %-10s | %-10s\n" "NP" "T_total (s)" "S" "E"
printf -- "------|----------------|------------|------------\n"

for NP in $NP_LIST; do
    TT=$(grep "Tmax" result_np${NP}.txt | awk '{sum += $3} END {printf "%.4f", sum}')
    if [ -n "$TT" ] && [ -n "$T_BASE" ] && [ "$T_BASE" != "0" ]; then
        S=$(awk "BEGIN{printf \"%.4f\", ${T_BASE}/${TT}}")
        E=$(awk "BEGIN{printf \"%.4f\", ${S}/${NP}}")
    else
        S="-"; E="-"
    fi
    printf "%-5s | %-14s | %-10s | %-10s\n" "$NP" "${TT:--}" "$S" "$E"
done

echo ""
echo "============================================================"
echo "  MPE-профилировка, NP=16"
echo "============================================================"

if [ -n "$BIN_MPE" ] && [ -f "$BIN_MPE" ]; then
    mpirun -machinefile $PBS_NODEFILE -np 16 -perhost 12 \
        $BIN_MPE > profile_np16.txt 2>&1
    grep "Tmax\|imbalance" profile_np16.txt | head -10

    # clog2 может называться по имени бинарника
    if ls *.clog2 1>/dev/null 2>&1; then
        mv *.clog2 profile_np16.clog2
        echo "Лог MPE сохранён  : profile_np16.clog2"
        echo "Открыть: jumpshot profile_np16.clog2"
    else
        echo "ВНИМАНИЕ: .clog2 не создан"
        echo "Проверьте: ldd $BIN_MPE | grep mpe"
        ls -la *.slog2 *.log 2>/dev/null || true
    fi
else
    echo "lb_mpe не собран, профилировка пропущена"
fi

echo ""
echo "=== Готово ==="
